    {
        "id": "bf39f08049fbb17e",
        "type": "function",
        "z": "d6e2d2f6d5fb912c",
        "name": "格式化各組溫濕度顯示",
        "func": "let parts = msg.topic.split('/');\nif (parts.length < 2) return null;\n\nlet user = parts[1];\nlet subTopic = parts.slice(2).join('/');\nlet val = msg.payload;\nlet text = \"\";\n\nif (typeof val === 'object' && val !== null) {\n    text = `[${user}] 收到物件資料: ${JSON.stringify(val)}`;\n} else if (subTopic.includes('temp') || subTopic.includes('溫度')) {\n    text = `[${user}] 溫度: ${val} °C`;\n} else if (subTopic.includes('hum') || subTopic.includes('濕度')) {\n    text = `[${user}] 濕度: ${val} %`;\n} else {\n    text = `[${user}] (${subTopic || '預設'}): ${val}`;\n}\n\nmsg.payload = text;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 300,
