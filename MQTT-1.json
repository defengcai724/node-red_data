        "type": "function",
        "z": "tab_project_b_ui1",
        "name": "【B組】模擬設備執行並產生狀態",
        "func": "let cmd = String(msg.payload).trim();\nlet statusMsg = \"\";\n\nif (cmd.toUpperCase() === \"ON\" || cmd === \"1\") {\n    statusMsg = \"LED 已開啟 (ON)\";\n} else if (cmd.toUpperCase() === \"OFF\" || cmd === \"0\") {\n    statusMsg = \"LED 已關閉 (OFF)\";\n} else if (!isNaN(Number(cmd))) {\n    statusMsg = `LED 亮度已調整為 ${cmd}%`;\n} else {\n    statusMsg = `設備已執行指令: ${cmd}`;\n}\n\nmsg.payload = statusMsg;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
