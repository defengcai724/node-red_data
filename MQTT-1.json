    {
        "id": "func_c_classify",
        "type": "function",
        "z": "tab_project_c_broadcast",
        "name": "依 Wildcard 結果分類訊息",
        "func": "// Topic 格式: AIOT/{user}/message/{category}\nlet parts = msg.topic.split('/');\nif (parts.length < 4) return null;\n\nlet user = parts[1];\nlet category = parts[3].toLowerCase();\nlet formatted = `[${user}] ${msg.payload}`;\n\n// [0]: 公告 (announcement), [1]: 警報 (alert), [2]: 狀態 (status), [3]: 總覽\nlet outputs = [null, null, null, { payload: `[${user} - ${category}] ${msg.payload}` }];\n\nif (category === 'announcement') {\n    outputs[0] = { payload: formatted };\n} else if (category === 'alert') {\n    outputs[1] = { payload: formatted };\n} else if (category === 'status') {\n    outputs[2] = { payload: formatted };\n}\n\nreturn outputs;",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 480,
        "wires": [
            [
                "ui_text_c_ann"
            ],
            [
                "ui_text_c_alert"
            ],
            [
                "ui_text_c_status"
            ],
            [
                "debug_c_all"
            ]
        ]
    },
